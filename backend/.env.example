# Backend StoryForge. Copy to backend/.env for local development.
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://usuario:senha@localhost:5432/storyforge?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
STFG_SECRET_KEY="replace-with-at-least-32-random-characters"
FRONTEND_URL="http://localhost:5173"
TRUST_PROXY_HOPS=0
COOKIE_SAME_SITE=lax
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
# Optional. Configure for shared rate limits across multiple backend instances.
# REDIS_URL=redis://localhost:6379
